# Copy this file to `.dev.vars` for local `wrangler dev` runs. `.dev.vars` is
# already gitignored at the repo root -- never commit real secret values.

# Neither the database (D1) nor profile-image storage (R2) needs an entry here
# -- `wrangler dev` emulates both locally with no credentials. Create/refresh
# the local database with:
#   npx wrangler d1 migrations apply contentpro-db --local
#   npx wrangler d1 execute contentpro-db --local --file=./seed.sql

# Long random string used to sign/verify session JWTs and the email-verification
# / password-reset action JWTs (HMAC-SHA256). Generate one with:
#   node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
JWT_SECRET="<generate-a-long-random-secret>"

# Resend API key (https://resend.com/api-keys) -- sends verification + password
# reset emails.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Cloudflare Turnstile secret key (https://dash.cloudflare.com/?to=/:account/turnstile)
# -- server-side validation for the public signup form.
TURNSTILE_SECRET_KEY="0x0000000000000000000000000000000000"
