# Copy to `.env` and edit only what you need. Every value has a working local
# default, so `docker compose up` runs out of the box with a seeded demo user.
# `.env` is gitignored — never commit real keys.

# Session signing secret. Any long random string for local use.
JWT_SECRET=local-dev-jwt-secret-change-me

# Cloudflare Turnstile — these are the public TEST keys (always pass). Replace
# with your real site/secret keys to enforce a genuine bot check on signup.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# OPTIONAL — email verification & password reset (the signup flow). Leave blank
# to skip: use the seeded demo account (demo@contentpro.local / demo1234)
# instead of signing up. Requires a Resend API key + a verified sender domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=ContentPro <onboarding@resend.dev>
