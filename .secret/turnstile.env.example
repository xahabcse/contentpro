# Cloudflare Turnstile. Local docker uses Cloudflare's public test keys by default (see the defaults in docker-compose.yml).
# Template: copy to .secret/turnstile.env and replace every xxxxxxxx with the real value. Never commit the real file.

# Turnstile site key (built into the app)
VITE_TURNSTILE_SITE_KEY=xxxxxxxx
# Turnstile secret (Worker secret)
TURNSTILE_SECRET_KEY=xxxxxxxx
