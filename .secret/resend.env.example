# Resend mail (verification, password reset). Blank key = mail off.
# Template: copy to .secret/resend.env and replace every xxxxxxxx with the real value. Never commit the real file.

# resend.com → API Keys (Worker secret)
RESEND_API_KEY=xxxxxxxx
# verified sender, e.g. Cardstock <no-reply@your-domain>
RESEND_FROM_EMAIL=xxxxxxxx
